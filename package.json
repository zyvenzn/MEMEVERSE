{
  "name": "memeverse-terminal",
  "version": "1.0.0",
  "private": true,
  "description": "MEMEVERSE offline-first multi-market trading simulator",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/prepare-web.mjs",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run build && cap run android",
    "assets:generate": "capacitor-assets generate"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
